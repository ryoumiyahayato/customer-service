{
  "scripts": {
    "dev": "wrangler dev",
    "dev:spa": "vite --host 127.0.0.1",
    "doctor": "node scripts/doctor.mjs",
    "doctor:online": "node scripts/doctor.mjs --online",
    "lifecycle:dry-run": "node scripts/lifecycle-dry-run.mjs",
    "lifecycle:ci-check": "node scripts/lifecycle-ci-check.mjs",
    "check-session-lifecycle": "node scripts/check-session-lifecycle.mjs",
    "check:lifecycle-boundaries": "node scripts/check-lifecycle-sql-boundaries.mjs",
    "check:business-closures": "node scripts/check-high-risk-business-closures.mjs",
    "bootstrap:cloudflare": "node scripts/bootstrap-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "build": "vite build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:whoami": "wrangler whoami",
