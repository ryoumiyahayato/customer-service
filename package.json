{
  "scripts": {
    "dev": "wrangler dev",
    "dev:spa": "vite --host 127.0.0.1",
    "build": "vite build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:whoami": "wrangler whoami",
    "db:migrate:local": "wrangler d1 migrations apply customer_chat_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply customer_chat_db --remote",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260620.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.104.0"
  }
}
