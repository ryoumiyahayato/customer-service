    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260620.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-legacy": "^7.2.1",
    "terser": "^5.48.0",
    "typescript": "^5.8.3",
    "wrangler": "4.104.0"
  }
}
