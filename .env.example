# Vercel environment variables
AUTH_SECRET=change-this-to-a-long-random-secret
DEFAULT_ADMIN_USERNAME=owner-root
DEFAULT_ADMIN_PASSWORD=replace-with-the-private-password-codex-gave-you
POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require

# Optional one-time recovery. Set to 1 for one redeploy, then remove it.
RESET_SUPER_ADMIN_ON_BOOTSTRAP=0

