# Core production runtime
NODE_ENV=production
AUTH_SECRET=replace-with-a-long-random-cookie-signing-secret
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_URL may be used instead of POSTGRES_URL when provided by the hosting platform.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Initial super-admin bootstrap. Required only until the first SUPER_ADMIN exists.
DEFAULT_ADMIN_USERNAME=owner-root
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-private-password
# Optional one-time recovery. Set to 1 for one redeploy, then set back to 0/remove.
RESET_SUPER_ADMIN_ON_BOOTSTRAP=0

# Redis-compatible Vercel KV / Upstash REST API for serverless rate limiting and bans.
# Strongly recommended in production. If absent, the app allows requests so login/register remain usable.
# Set API_SECURITY_FAIL_CLOSED=1 only after KV/Redis is confirmed healthy.
API_SECURITY_FAIL_CLOSED=0
# In production these are required; without them API requests fail closed with 503.
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=replace-with-kv-rest-token
# Alternative variable names supported by the code:
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# API security policy knobs
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_GLOBAL_MAX=60
API_RATE_LIMIT_AUTH_MAX=10
AUTH_FAILURE_LIMIT=5
AUTH_SLOWDOWN_FAILURES=3
AUTH_BAN_SECONDS=600
