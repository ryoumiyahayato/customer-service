{
  "name": "customer-chat-windows-deploy-wizard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node dist/index.js --smoke",
    "plan": "npm run build && node dist/index.js plan",
    "deploy": "npm run build && node dist/index.js deploy",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
