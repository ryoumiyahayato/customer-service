APP_DOMAIN=admin.example.com
VISITOR_ROOT_DOMAIN=visitor.example.com
POSTGRES_DB=customer_chat
POSTGRES_USER=customer_chat
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://customer_chat:change-me-postgres-password@postgres:5432/customer_chat
APP_PORT=3000
SESSION_SECRET=change-me-strong-random-session-secret
SETUP_TOKEN=change-me-strong-random-setup-token
ADMIN_SESSION_TTL=86400
ENCRYPTION_ENABLED=0
# Use a strong random 32-byte key encoded as base64 or 64 hex characters.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
STORAGE_DRIVER=local
# Local filesystem path mounted into the app container for attachments.
STORAGE_PATH=/app/storage
# Maximum attachment upload size in bytes.
MAX_UPLOAD_SIZE=10485760
# Cron expression reserved for the generic server lifecycle runner.
LIFECYCLE_CRON=0 * * * *
LOG_LEVEL=info
BACKUP_DIR=./backup
