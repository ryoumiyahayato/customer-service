APP_DOMAIN=admin.example.com
VISITOR_ROOT_DOMAIN=visitor.example.com
POSTGRES_DB=customer_chat
POSTGRES_USER=customer_chat
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://customer_chat:change-me-postgres-password@postgres:5432/customer_chat
APP_PORT=3000
APP_BIND_HOST=0.0.0.0
APP_UID=1000
APP_GID=1000
SESSION_SECRET=change-me-strong-random-session-secret
SETUP_TOKEN=change-me-strong-random-setup-token
ADMIN_SESSION_TTL=86400
# Public server-generic exposure is blocked by default because this adapter remains experimental.
# Fill the exact acknowledgement only after reviewing deploy/linux/VPS_ACCEPTANCE.md and accepting the risks.
SELF_HOST_EXPERIMENTAL_PUBLIC_ACK=
ENCRYPTION_ENABLED=0
# Use a strong random 32-byte key encoded as base64 or 64 hex characters.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
STORAGE_DRIVER=local
# Local filesystem path mounted into the app container for attachments.
STORAGE_PATH=/app/storage
# Maximum attachment upload size in bytes.
MAX_UPLOAD_SIZE=10485760
# Basic application-layer abuse guard. This does not replace upstream DDoS protection.
ABUSE_LOGIN_LIMIT=5
ABUSE_LOGIN_WINDOW_SECONDS=300
ABUSE_SETUP_LIMIT=5
ABUSE_SETUP_WINDOW_SECONDS=600
ABUSE_GUEST_LIMIT=30
ABUSE_GUEST_WINDOW_SECONDS=600
ABUSE_MESSAGE_LIMIT=60
ABUSE_MESSAGE_IP_LIMIT=180
ABUSE_MESSAGE_WINDOW_SECONDS=60
ABUSE_UPLOAD_LIMIT=20
ABUSE_UPLOAD_WINDOW_SECONDS=600
# Cron expression reserved for the generic server lifecycle runner.
LIFECYCLE_CRON=0 * * * *
LOG_LEVEL=info
BACKUP_DIR=./backup
# Separate 32+ character secret used to authenticate backup manifests.
BACKUP_SIGNING_KEY=change-me-strong-random-backup-signing-key
