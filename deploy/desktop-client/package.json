{
  "name": "customer-chat-desktop-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node dist/index.js --smoke",
    "plan": "npm run build && node dist/index.js --plan examples/client-config.example.json",
    "package:check": "npm run build && node dist/index.js --package-check",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
